[Unit]
Description=OIP live host OPC-UA service
After=network.target

[Service]
Type=simple
Environment=OIP_OPCUA_PORT=4840
ExecStart=%h/.local/share/oip-host-opcua/venv/bin/python %h/.local/share/oip-host-opcua/oip_host_opcua.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/proc /sys /etc/os-release
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
