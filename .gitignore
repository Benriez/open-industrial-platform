# Rust builds
/target/
**/target/

# Frontend builds and installed dependencies
node_modules/
**/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/coverage/

# Test and coverage output
/coverage/
**/coverage/
*.profraw
# Python acceptance-runner cache
__pycache__/
*.pyc

# Local runtime state and databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
# Persistent advisory ownership sidecars contain no source content.
*.oip-lock

# Temporary and editor files
*.tmp
*.temp
*.log
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
secrets/
**/secrets/
/pki/
**/pki/

# The manually supplied HTML design reference is intentionally tracked.
!design/reference/
!design/reference/*.html

# Flutter local build state (also covered by generated app gitignore)
/apps/flutter/build/
/apps/flutter/.dart_tool/
/apps/flutter/macos/Pods/
/apps/flutter/macos/Flutter/ephemeral/

# Local IPC authentication, endpoints and ownership (never source)
*.credential
*.credentials
*.token
*.sock
*.socket
*.ipc-lock
/ipc.json

# Initial Git baseline evidence policy
# Full original evidence remains local and in the verified external archive.
# Keep only these explicitly reviewed reports/manifests; see docs/oip-initial-git-baseline.md.
/docs/evidence/**/*
!/docs/evidence/**/
!/docs/evidence/oip003/artifacts.json
!/docs/evidence/oip003/browser-verification.json
!/docs/evidence/oip003/persistence-verification.json
