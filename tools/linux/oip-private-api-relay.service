[Unit]
Description=OIP private tailnet API relay
After=network-online.target
[Service]
ExecStart=/usr/bin/python3 %h/oip-platform/tools/oip_tcp_relay.py --listen-host 100.127.113.104 --listen-port 18809 --target-host 127.0.0.1 --target-port 18808
Restart=always
RestartSec=3
NoNewPrivileges=true
[Install]
WantedBy=default.target
